@model List<CRMProject.Services.Models.KullaniciListeItem>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var mevcutKullaniciId = ViewBag.MevcutKullaniciId as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Kullanıcı Yönetimi</h4>
    <a asp-action="Ekle" class="btn btn-primary">
        <i class="fa-solid fa-user-plus me-1"></i> Yeni Kullanıcı
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    var kendiHesabiMi = k.Id == mevcutKullaniciId;
                    <tr>
                        <td>
                            @k.AdSoyad
                            @if (kendiHesabiMi)
                            {
                                <span class="badge bg-info text-dark ms-1">Siz</span>
                            }
                        </td>
                        <td>@k.Eposta</td>
                        <td>
                            @if (kendiHesabiMi)
                            {
                                <span class="text-muted">@k.Rol</span>
                            }
                            else
                            {
                                <form asp-action="RolDegistir" method="post" class="d-flex align-items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="KullaniciId" value="@k.Id" />
                                    <select name="YeniRol" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                                        <option value="Admin" selected="@(k.Rol == "Admin")">Admin</option>
                                        <option value="Kullanici" selected="@(k.Rol == "Kullanici")">Kullanıcı</option>
                                    </select>
                                </form>
                            }
                        </td>
                        <td>
                            @if (k.Aktif)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (kendiHesabiMi)
                            {
                                <span class="text-muted small">Kendi hesabınız</span>
                            }
                            else
                            {
                                var yeniDurum = !k.Aktif;
                                <form asp-action="AktifPasifYap" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="kullaniciId" value="@k.Id" />
                                    <input type="hidden" name="aktif" value="@(yeniDurum.ToString())" />
                                    @if (k.Aktif)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Bu kullanıcıyı pasifleştirmek istediğinize emin misiniz?');">
                                            <i class="fa-solid fa-user-slash"></i> Pasifleştir
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="fa-solid fa-user-check"></i> Aktifleştir
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@model CRMProject.Web.Models.KullaniciViewModels.KullaniciEkleViewModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<h4 class="fw-bold mb-4">Yeni Kullanıcı Ekle</h4>

<div class="card border-0 shadow-sm" style="max-width: 500px;">
    <div class="card-body">
        <form asp-action="Ekle" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="AdSoyad" class="form-label"></label>
                <input asp-for="AdSoyad" class="form-control" placeholder="Örn: Ayşe Yılmaz" />
                <span asp-validation-for="AdSoyad" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Eposta" class="form-label"></label>
                <input asp-for="Eposta" class="form-control" placeholder="ornek@esbi.com.tr" />
                <span asp-validation-for="Eposta" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sifre" class="form-label"></label>
                <input asp-for="Sifre" class="form-control" placeholder="En az 6 karakter" />
                <span asp-validation-for="Sifre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select">
                    <option value="">Seçiniz...</option>
                    <option value="Admin">Admin</option>
                    <option value="Kullanici">Kullanıcı</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check me-1"></i> Kaydet
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model CRMProject.Web.Models.MalzemeViewModels.MalzemeViewModel
@{
    var kategoriler = ViewBag.Kategoriler as List<string> ?? new List<string>();
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="MalzemeKodu" class="form-label"></label>
        <input asp-for="MalzemeKodu" class="form-control" placeholder="Örn: MLZ-001" />
        <div class="form-text">Her malzemeye özel, tekrarsız bir kod.</div>
        <span asp-validation-for="MalzemeKodu" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Kategori" class="form-label"></label>
        <input asp-for="Kategori" class="form-control" list="kategoriListesi" placeholder="Örn: Elektronik" />
        <datalist id="kategoriListesi">
            @foreach (var kat in kategoriler)
            {
                <option value="@kat"></option>
            }
        </datalist>
        <div class="form-text">Mevcut bir kategori yazabilir veya yeni bir tane oluşturabilirsiniz.</div>
    </div>

    <div class="col-md-4">
        <label asp-for="Birim" class="form-label"></label>
        <select asp-for="Birim" class="form-select">
            <option value="">Seçiniz...</option>
            <option value="Adet">Adet</option>
            <option value="Kg">Kg</option>
            <option value="Lt">Lt</option>
            <option value="Mt">Mt</option>
            <option value="Kutu">Kutu</option>
        </select>
        <span asp-validation-for="Birim" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="MalzemeAdi" class="form-label"></label>
        <input asp-for="MalzemeAdi" class="form-control" placeholder="Malzeme / ürün adı" />
        <span asp-validation-for="MalzemeAdi" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="SatisFiyati" class="form-label"></label>
        <div class="input-group">
            <input asp-for="SatisFiyati" type="number" step="0.01" class="form-control" placeholder="0.00" />
            <span class="input-group-text">₺</span>
        </div>
        <span asp-validation-for="SatisFiyati" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="AlisFiyati" class="form-label"></label>
        <div class="input-group">
            <input asp-for="AlisFiyati" type="number" step="0.01" class="form-control" placeholder="0.00" />
            <span class="input-group-text">₺</span>
        </div>
        <span asp-validation-for="AlisFiyati" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="StokMiktari" class="form-label"></label>
        <input asp-for="StokMiktari" type="number" step="0.01" class="form-control" placeholder="0" />
        <span asp-validation-for="StokMiktari" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="KritikStok" class="form-label"></label>
        <input asp-for="KritikStok" type="number" step="0.01" class="form-control" placeholder="0" />
        <div class="form-text">Stok bu seviyenin altına düşünce listede kırmızı uyarı çıkar.</div>
        <span asp-validation-for="KritikStok" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Aciklama" class="form-label"></label>
        <textarea asp-for="Aciklama" class="form-control" rows="2" placeholder="İsteğe bağlı açıklama..."></textarea>
    </div>
</div>
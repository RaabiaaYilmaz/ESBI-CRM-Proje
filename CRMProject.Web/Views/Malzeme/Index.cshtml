@model List<CRMProject.Data.Entities.Malzeme>
@{
    ViewData["Title"] = "Malzeme Yönetimi";
    var kategoriler = ViewBag.Kategoriler as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Malzeme Yönetimi</h4>
    <a asp-action="Ekle" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Yeni Malzeme
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="aramaMetni" value="@ViewBag.AramaMetni" class="form-control" placeholder="Malzeme kodu veya adına göre ara..." />
            </div>
            <div class="col-md-3">
                <select name="kategori" class="form-select">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var kat in kategoriler)
                    {
                        <option value="@kat" selected="@(kat == (string)ViewBag.SeciliKategori)">@kat</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-magnifying-glass"></i> Ara
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace((string)ViewBag.AramaMetni) || !string.IsNullOrWhiteSpace((string)ViewBag.SeciliKategori))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-danger">
                        <i class="fa-solid fa-xmark"></i> Temizle
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-4 mb-0 text-center">Kayıt bulunamadı.</p>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Malzeme Kodu</th>
                        <th>Adı</th>
                        <th>Kategori</th>
                        <th>Birim</th>
                        <th class="text-end">Satış Fiyatı</th>
                        <th class="text-end">Stok</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        var kritikMi = m.StokMiktari <= m.KritikStok;
                        <tr class="@(kritikMi ? "table-danger" : "")">
                            <td class="fw-semibold">@m.MalzemeKodu</td>
                            <td>@m.MalzemeAdi</td>
                            <td>@(m.Kategori ?? "-")</td>
                            <td>@m.Birim</td>
                            <td class="text-end">@m.SatisFiyati.ToString("N2") ₺</td>
                            <td class="text-end">
                                @if (kritikMi)
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>@m.StokMiktari
                                    </span>
                                }
                                else
                                {
                                    <span>@m.StokMiktari</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Duzenle" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="Sil" asp-route-id="@m.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu malzemeyi silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
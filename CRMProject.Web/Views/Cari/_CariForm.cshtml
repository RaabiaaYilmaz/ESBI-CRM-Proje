@model CRMProject.Web.Models.CariViewModels.CariViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="CariKodu" class="form-label"></label>
        <input asp-for="CariKodu" class="form-control" placeholder="Örn: CARI-001" />
        <div class="form-text">Her cariye özel, tekrarsız bir kod (örn: CARI-001, MST-2026-01).</div>
        <span asp-validation-for="CariKodu" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CariTipi" class="form-label"></label>
        <select asp-for="CariTipi" class="form-select">
            <option value="">Seçiniz...</option>
            <option value="Müşteri">Müşteri</option>
            <option value="Tedarikçi">Tedarikçi</option>
            <option value="Her İkisi">Her İkisi</option>
        </select>
        <span asp-validation-for="CariTipi" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Telefon" class="form-label"></label>
        <input asp-for="Telefon" class="form-control" placeholder="Örn: 0532 123 45 67" />
        <span asp-validation-for="Telefon" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Unvan" class="form-label"></label>
        <input asp-for="Unvan" class="form-control" placeholder="Firma veya kişi adı" />
        <span asp-validation-for="Unvan" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Eposta" class="form-label"></label>
        <input asp-for="Eposta" class="form-control" placeholder="ornek@firma.com" />
        <span asp-validation-for="Eposta" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="VergiDairesi" class="form-label"></label>
        <input asp-for="VergiDairesi" class="form-control" placeholder="Örn: Adapazarı V.D." />
    </div>

    <div class="col-md-4">
        <label asp-for="VergiNo" class="form-label"></label>
        <input asp-for="VergiNo" class="form-control" placeholder="10 haneli vergi no" />
    </div>

    <div class="col-md-4">
        <label asp-for="Il" class="form-label"></label>
        <input asp-for="Il" class="form-control" placeholder="Örn: Sakarya" />
    </div>

    <div class="col-md-8">
        <label asp-for="Ilce" class="form-label"></label>
        <input asp-for="Ilce" class="form-control" placeholder="Örn: Akyazı" />
    </div>

    <div class="col-12">
        <label asp-for="Adres" class="form-label"></label>
        <textarea asp-for="Adres" class="form-control" rows="2" placeholder="Açık adres..."></textarea>
    </div>
</div>
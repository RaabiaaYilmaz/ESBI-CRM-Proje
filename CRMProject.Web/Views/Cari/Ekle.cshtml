@model CRMProject.Web.Models.CariViewModels.CariViewModel
@{
    ViewData["Title"] = "Yeni Cari";
}

<h4 class="fw-bold mb-4">Yeni Cari Ekle</h4>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Ekle" method="post">
            @Html.AntiForgeryToken()
            <partial name="_CariForm" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check me-1"></i> Kaydet
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model List<CRMProject.Data.Entities.Cari>
@{
    ViewData["Title"] = "Cari Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Cari Yönetimi</h4>
    <a asp-action="Ekle" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Yeni Cari
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="aramaMetni" value="@ViewBag.AramaMetni" class="form-control" placeholder="Cari kodu veya ünvana göre ara..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-magnifying-glass"></i> Ara
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace((string)ViewBag.AramaMetni))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-danger">
                        <i class="fa-solid fa-xmark"></i> Temizle
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-4 mb-0 text-center">Kayıt bulunamadı.</p>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Cari Kodu</th>
                        <th>Ünvan</th>
                        <th>Tip</th>
                        <th>Telefon</th>
                        <th>E-posta</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cari in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@cari.CariKodu</td>
                            <td>@cari.Unvan</td>
                            <td><span class="badge bg-secondary">@cari.CariTipi</span></td>
                            <td>@(cari.Telefon ?? "-")</td>
                            <td>@(cari.Eposta ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="Duzenle" asp-route-id="@cari.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="Sil" asp-route-id="@cari.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu cariyi silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>